# Postgres connection string (Railway injects this automatically when you add the Postgres plugin).
# Leave unset for local dev to fall back to a local SQLite file.
DATABASE_URL=

# Used to sign session cookies and JWTs. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Bootstrap admin account, created automatically on first startup if no users exist yet.
ADMIN_USERNAME=christopher
ADMIN_PASSWORD=change-me
ADMIN_DISPLAY_NAME=Christopher
ADMIN_COLOR=#4A90D9

# Recipe import (Anthropic API) — optional. Without it, the Recipes feature still works
# for manual entry; the Link/Photo/Paste import UI just hides itself.
# Get a key at https://console.anthropic.com -> Settings -> API keys.
ANTHROPIC_API_KEY=

# Model used to extract recipes from pages, photos and pasted text.
# Roughly $0.02-0.03 per import on Sonnet; claude-opus-5 is more accurate on
# handwriting and messy scans at roughly 3x the cost.
RECIPE_MODEL=claude-sonnet-5
